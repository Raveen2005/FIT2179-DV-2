{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Public Transport Stop Density Hotspots",
  "width": 900,
  "height": 600,

  "data": {
    "url": "data/stops.geojson",
    "format": {"type": "json", "property": "features"}
  },

  "projection": {
    "type": "mercator",
    "center": [144.9631, -37.8136],
    "scale": 30000
  },

  "layer": [
    {
      "data": {
        "url": "data/suburbs.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f1f1",
        "stroke": "#cccccc",
        "strokeWidth": 0.3
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "lon"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "lat"
        }
      ],
      "mark": {
  "type": "circle",
  "opacity": 0.45
},
"encoding": {
  "longitude": {"field": "lon", "type": "quantitative"},
  "latitude": {"field": "lat", "type": "quantitative"},
  "size": {
    "aggregate": "count",
    "type": "quantitative",
    "title": "Stop density",
    "scale": {"range": [10, 600]}
  },
  "color": {
    "aggregate": "count",
    "type": "quantitative",
    "title": "Stop density",
    "scale": {
      "scheme": "orangered"
    }
  },
  "tooltip": [
    {"aggregate": "count", "type": "quantitative", "title": "Stops in area"}
  ]
}
    }
  ]
}