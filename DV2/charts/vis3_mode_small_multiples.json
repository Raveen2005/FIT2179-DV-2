{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Public Transport Stop Distribution by Mode",

  "data": {
    "url": "data/stops.geojson",
    "format": {"type": "json", "property": "features"}
  },

  "transform": [
    {
      "calculate": "datum.properties.MODE",
      "as": "Mode"
    },
    {
      "filter": "datum.Mode == 'METRO BUS' || datum.Mode == 'METRO TRAIN' || datum.Mode == 'METRO TRAM'"
    }
  ],

  "facet": {
    "field": "Mode",
    "type": "nominal",
    "columns": 3,
    "title": null
  },

  "spec": {
    "width": 280,
    "height": 280,

    "projection": {
      "type": "mercator",
      "center": [144.9631, -37.8136],
      "scale": 28000
    },

    "layer": [
      {
        "data": {
          "url": "data/suburbs.geojson",
          "format": {"type": "json", "property": "features"}
        },
        "mark": {
          "type": "geoshape",
          "fill": "#eeeeee",
          "stroke": "#cccccc",
          "strokeWidth": 0.3
        }
      },
      {
        "mark": {
          "type": "circle",
          "opacity": 0.75,
          "size": 8
        },
        "encoding": {
          "longitude": {"field": "geometry.coordinates[0]", "type": "quantitative"},
          "latitude": {"field": "geometry.coordinates[1]", "type": "quantitative"},
          "color": {
            "field": "Mode",
            "type": "nominal",
            "legend": null
          },
          "tooltip": [
            {"field": "properties.STOP_NAME", "title": "Stop"},
            {"field": "Mode", "title": "Mode"}
          ]
        }
      }
    ]
  }
}