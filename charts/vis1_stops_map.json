{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Public Transport Stops Across Melbourne by Mode",
  "width": 900,
  "height": 600,
  "projection": {
    "type": "mercator",
    "center": [144.9631, -37.8136],
    "scale": 30000
  },
  "layer": [
    {
      "data": {
        "url": "data/suburbs.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "#bdbdbd",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/stops.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "size": 14,
        "stroke": "white",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {"field": "geometry.coordinates[0]", "type": "quantitative"},
        "latitude": {"field": "geometry.coordinates[1]", "type": "quantitative"},
        "color": {
          "field": "properties.MODE",
          "type": "nominal",
          "title": "Transport Mode"
        },
        "tooltip": [
          {"field": "properties.STOP_NAME", "title": "Stop"},
          {"field": "properties.MODE", "title": "Mode"}
        ]
      }
    }
  ]
}