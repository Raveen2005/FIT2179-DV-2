{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Monthly Public Transport Patronage by Mode",
  "width": 900,
  "height": 450,

  "data": {
    "url": "data/Monthly public transport patronage by mode.csv"
  },

  "transform": [
    {
      "calculate": "datetime(datum.Year, datum.Month - 1, 1)",
      "as": "Date"
    },
    {
      "fold": [
        "Metropolitan train",
        "Metropolitan tram",
        "Metropolitan bus",
        "Regional train",
        "Regional coach",
        "Regional bus"
      ],
      "as": ["Mode", "Patronage"]
    },
    {
      "calculate": "toNumber(replace(datum.Patronage, /,/g, ''))",
      "as": "Trips"
    }
  ],

  "mark": {
    "type": "line",
    "point": false,
    "interpolate": "monotone"
  },

  "encoding": {
    "x": {
      "field": "Date",
      "type": "temporal",
      "title": "Year"
    },
    "y": {
      "field": "Trips",
      "type": "quantitative",
      "title": "Passenger Trips"
    },
    "color": {
  "field": "Mode",
  "type": "nominal",
  "title": "Transport Mode",
  "scale": {
    "domain": [
      "Metropolitan train",
      "Metropolitan tram",
      "Metropolitan bus",
      "Regional train",
      "Regional coach",
      "Regional bus"
    ],
    "range": [
      "#E4572E",
      "#4C78A8",
      "#54A24B",
      "#F2CF5B",
      "#B279A2",
      "#72B7B2"
    ]
  }
},
    "tooltip": [
      {"field": "Date", "type": "temporal"},
      {"field": "Mode"},
      {"field": "Trips", "type": "quantitative", "format": ","}
    ]
  }
}